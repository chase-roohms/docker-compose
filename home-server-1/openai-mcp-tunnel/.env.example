# OpenAI Platform API key with Tunnels Read + Use permissions.
CONTROL_PLANE_API_KEY=sk-your-openai-platform-key

# Tunnel ID from OpenAI Platform tunnel settings.
CONTROL_PLANE_TUNNEL_ID=tunnel_your-tunnel-id

# Dedicated LiteLLM virtual key (NOT the LiteLLM master key).
LITELLM_MCP_KEY=sk-your-litellm-virtual-key

# Optional: override when LiteLLM isn't reachable on home-server-1:4000.
# MCP_SERVER_URL=http://host.docker.internal:4000/mcp
