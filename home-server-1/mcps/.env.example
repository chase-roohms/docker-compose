# Copy to .env and fill in your actual values. Never commit .env.
# This is the LAN IP already configured in home-server-1/gramps/docker-compose.yml.
# Change it if your server address changes.
MCP_BIND_IP=192.168.1.113
GRAMPS_MCP_PORT=8992

# Gramps Web already publishes port 8991 on home-server-1.
# The MCP container reaches this address through Docker's host gateway.
GRAMPS_API_URL=http://host.docker.internal:8991

# Gramps Web account allowed to read the tree (prefer a dedicated account).
GRAMPS_USERNAME=replace-me
GRAMPS_PASSWORD=replace-me

# Tree UUID (see Gramps Web settings or /api/metadata/).
GRAMPS_TREE_ID=replace-with-tree-uuid

# Use a random secret (at least 16 characters): openssl rand -base64 32
# Supply this value to LiteLLM when registering the MCP server.
MCP_API_KEY=replace-with-long-random-key

# Safer default: read-only while validating Gramps data and MCP tools.
# Change to false once you're ready for agent write actions.
GRAMPS_READ_ONLY=true

# LegendKeeper MCP (separate token from the Gramps MCP key).
LEGENDKEEPER_MCP_PORT=8993
# API key from LegendKeeper Project Settings > Developers > API Keys.
LEGENDKEEPER_API_KEY=replace-with-legendkeeper-api-key
# Generate with: openssl rand -hex 32. Configure this as LiteLLM's upstream bearer token.
LEGENDKEEPER_MCP_AUTH_TOKEN=replace-with-long-random-token
# Safer default: expose only read tools until intentionally enabled.
LEGENDKEEPER_READ_ONLY=true
